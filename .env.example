# magpie server configuration.
# Copy to .env (or export these) and adjust as needed.
# Values shown are the defaults applied when the variable is unset.

# Address the HTTP server listens on.
MAGPIE_ADDR=:8080

# Path to the SQLite database file.
MAGPIE_DB_PATH=./magpie.db

# Log format: empty for text, "json" for structured logs.
MAGPIE_LOG=

# NVD API key. Optional; raises rate limits for CPE/NVD lookups.
NVD_API_KEY=

# Max age before cached source data is refreshed (Go duration syntax).
MAGPIE_MAX_AGE=24h

# Per-request timeout for the HTTP API (Go duration syntax).
MAGPIE_REQUEST_TIMEOUT=30s
