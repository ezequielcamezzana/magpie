# magpie server configuration.
# Copy to .env (or export these) and adjust as needed.
# Values shown are the defaults applied when the variable is unset.

# Address the HTTP server listens on.
MAGPIE_ADDR=:8080

# Path to the SQLite database file.
MAGPIE_DB_PATH=./magpie.db

# Log format: empty for text, "json" for structured logs.
MAGPIE_LOG=

# Log level: debug, info (default), warn, error. Set debug to see per-request
# NVD latency ("nvd response" ms=...).
MAGPIE_LOG_LEVEL=

# NVD API key. Optional; raises rate limits for CPE/NVD lookups.
NVD_API_KEY=

# VulnCheck API key. Used by CPER to resolve CVEs via VulnCheck. Without it the
# endpoint returns 401 and CPER does not resolve.
VULNCHECK_API_KEY=

# Max age before cached data is refreshed (Go duration syntax). Per data type;
# each falls back to MAGPIE_MAX_AGE (if set), then to the default below.
# MAGPIE_MAX_AGE=24h          # global fallback for all of the below
MAGPIE_MAX_AGE_COMPONENTS=168h # components/repos (+ eco vulns); default 7d
MAGPIE_MAX_AGE_VULNS=12h       # OSV + NVD vuln records; default 12h
MAGPIE_MAX_AGE_CPES=168h       # resolved CPEs; default 7d
MAGPIE_MAX_AGE_MISSED_CPE=24h  # negative cache (no CPE found); default 24h

# Per-request timeout for the HTTP API (Go duration syntax).
MAGPIE_REQUEST_TIMEOUT=30s

# Per-source live-fetch budget. If a source (ecosyste.ms, OSV, CPER, NVD) takes
# longer than this, the stage is cancelled and falls back to cached data (even
# if stale) with a non-fatal warning, keeping /collect fast. 0 = no bound.
MAGPIE_SOURCE_BUDGET=5s

# Background passive updater: every INTERVAL it re-collects the BATCH oldest
# packages older than STALE_TIME, re-running the full pipeline without the
# cache. Opt-in (off by default).
MAGPIE_UPDATER_ENABLED=false
MAGPIE_UPDATER_INTERVAL=1m     # how often a refresh cycle runs
MAGPIE_UPDATER_STALE_TIME=12h  # a package older than this is eligible
MAGPIE_UPDATER_BATCH=1         # packages refreshed per cycle
